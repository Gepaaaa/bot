# AI Studio & 24/7 Bot Server Environment Variables
PORT=3000
NODE_ENV=development
GEMINI_API_KEY=

# Optional: Persistent volume path on Fly.io / Docker (e.g. /data) for .baileys_auth & .bot-state.json
DATA_DIR=

# Optional: Set when deploying Frontend UI separately on Vercel to point to your 24/7 Bot Server (e.g. https://bot--ztdpa.fly.dev)
VITE_BACKEND_URL=
